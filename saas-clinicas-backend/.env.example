# Copie para .env e ajuste se necessário
DATABASE_URL="postgresql://saas_clinicas:saas_clinicas@localhost:5432/saas_clinicas"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Autenticação. Gere um segredo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true em produção (HTTPS)
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5

# LGPD: dias até o IP/user agent serem apagados dos logs de auditoria
AUDIT_IP_RETENTION_DAYS=180
