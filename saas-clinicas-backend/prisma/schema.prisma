generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSIONAL
  RECEPTION
}

/// A clínica é o tenant: toda entidade de negócio aponta para ela via `tenantId`.
model Clinic {
  id                        String    @id @default(uuid()) @db.Uuid
  name                      String
  /// Subdomínio da clínica (ex.: "sorriso" em sorriso.dominio.com). Definido na criação, não muda
  slug                      String    @unique
  email                     String
  phone                     String
  document                  String?
  /// Fuso IANA usado na agenda e no horário de funcionamento
  timeZone                  String    @default("America/Sao_Paulo")
  /// Duração sugerida para um agendamento novo
  defaultAppointmentMinutes Int       @default(30)
  /// Clínica inativa bloqueia o acesso de todos os usuários dela
  active                    Boolean   @default(true)
  /// LGPD: pedido de exclusão feito pelo admin da clínica
  deletionRequestedAt       DateTime?
  deletionRequestedById     String?   @db.Uuid
  deletionReason            String?
  /// Preenchido quando o master confirma; a exclusão definitiva ocorre nesta data
  deletionScheduledFor      DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  businessHours  ClinicBusinessHour[]
  branding       ClinicBranding?
  users          User[]
  refreshTokens  RefreshToken[]
  patients       Patient[]
  patientRecords PatientRecord[]

  @@map("clinics")
}

model ClinicBusinessHour {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  /// 0 = domingo ... 6 = sábado
  weekday  Int
  /// Formato HH:mm
  opensAt  String
  /// Formato HH:mm
  closesAt String

  clinic Clinic @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
  @@map("clinic_business_hours")
}

/// Identidade visual da clínica (1:1). Fica fora de `clinics` para que o logo
/// (bytes) não seja carregado em toda consulta da clínica.
model ClinicBranding {
  tenantId      String    @id @db.Uuid
  /// Cor principal no formato #RRGGBB; null usa a cor padrão do sistema
  primaryColor  String?
  /// PNG, JPEG ou WebP, validado pelos bytes (até 512 KB)
  logo          Bytes?
  logoMimeType  String?
  /// Muda a cada troca do logo; o front usa para invalidar o cache da imagem
  logoUpdatedAt DateTime?
  updatedAt     DateTime  @updatedAt

  clinic Clinic @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("clinic_brandings")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  name               String
  /// Único na plataforma: o login será feito por e-mail
  email              String     @unique
  passwordHash       String
  /// Um usuário pode ter vários papéis (ex.: admin e profissional); pelo menos um
  roles              UserRole[]
  active             Boolean    @default(true)
  /// Senha provisória: o usuário precisa trocá-la no próximo login
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  clinic         Clinic          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  patientRecords PatientRecord[]

  @@index([tenantId])
  @@map("users")
}

/// Refresh token de sessão. Guardamos só o hash SHA-256 do valor enviado no cookie.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  clinic Clinic @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

/// Administrador da plataforma (master). Não pertence a nenhuma clínica.
model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens PlatformRefreshToken[]

  @@map("platform_admins")
}

/// Refresh token das sessões de plataforma (só o hash SHA-256).
model PlatformRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_refresh_tokens")
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
}

/// Log de auditoria: só aceita inserção (uma trigger bloqueia UPDATE/DELETE,
/// salvo em manutenção). O tenantId não tem FK de propósito: o log sobrevive,
/// anonimizado, à exclusão da clínica.
model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String?        @db.Uuid
  actorType   AuditActorType
  actorId     String?        @db.Uuid
  /// Nome do ator no momento do evento
  actorLabel  String
  /// Formato recurso.verbo_no_passado, ex.: user.deactivated
  action      String
  targetType  String?
  targetId    String?        @db.Uuid
  targetLabel String?
  /// Só ids, papéis, booleanos e campos alterados; nunca dados pessoais
  metadata    Json           @default("{}")
  ip          String?
  userAgent   String?
  occurredAt  DateTime       @default(now())

  @@index([tenantId, occurredAt(sort: Desc), id])
  @@index([occurredAt(sort: Desc), id])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  OTHER
  UNDISCLOSED
}

/// Paciente de uma clínica. O CPF é único dentro da clínica; o mesmo CPF pode
/// existir em outra, sem nenhum vínculo entre os cadastros.
model Patient {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  name                  String
  /// Nome social, exibido no atendimento quando informado
  socialName            String?
  /// Somente dígitos
  cpf                   String
  birthDate             DateTime @db.Date
  gender                Gender?
  phone                 String?
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Inativado, nunca apagado: o prontuário precisa ser guardado
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clinic  Clinic          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records PatientRecord[]

  @@unique([tenantId, cpf])
  @@index([tenantId, name])
  @@map("patients")
}

/// Registro de atendimento (prontuário). Imutável: correções e complementos
/// entram como adendo (amendsId aponta para o registro original).
model PatientRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  patientId      String   @db.Uuid
  /// Quem atendeu (profissional ou admin)
  professionalId String   @db.Uuid
  /// Data do atendimento
  occurredAt     DateTime @default(now())
  notes          String
  amendsId       String?  @db.Uuid
  createdAt      DateTime @default(now())

  clinic       Clinic          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional User            @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amends       PatientRecord?  @relation("RecordAmendments", fields: [amendsId], references: [id], onDelete: Cascade)
  amendments   PatientRecord[] @relation("RecordAmendments")

  @@index([tenantId, patientId, occurredAt(sort: Desc)])
  @@index([amendsId])
  @@map("patient_records")
}
