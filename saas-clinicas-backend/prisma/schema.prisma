generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSIONAL
  RECEPTION
}

/// A clínica é o tenant: toda entidade de negócio aponta para ela via `tenantId`.
model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String
  document  String?
  /// Clínica inativa bloqueia o acesso de todos os usuários dela
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessHours ClinicBusinessHour[]
  users         User[]
  refreshTokens RefreshToken[]

  @@map("clinics")
}

model ClinicBusinessHour {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  /// 0 = domingo ... 6 = sábado
  weekday  Int
  /// Formato HH:mm
  opensAt  String
  /// Formato HH:mm
  closesAt String

  clinic Clinic @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
  @@map("clinic_business_hours")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  name               String
  /// Único na plataforma: o login será feito por e-mail
  email              String   @unique
  passwordHash       String
  role               UserRole
  active             Boolean  @default(true)
  /// Senha provisória: o usuário precisa trocá-la no próximo login
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clinic        Clinic         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("users")
}

/// Refresh token de sessão. Guardamos só o hash SHA-256 do valor enviado no cookie.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  clinic Clinic @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

/// Administrador da plataforma (master). Não pertence a nenhuma clínica.
model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens PlatformRefreshToken[]

  @@map("platform_admins")
}

/// Refresh token das sessões de plataforma (só o hash SHA-256).
model PlatformRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_refresh_tokens")
}
